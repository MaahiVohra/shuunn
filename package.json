{
  "name": "shuunn",
  "version": "0.1.0-alpha.1",
  "description": "shuunn - Your media, in motion. High-density anime desktop client with embedded torrent engine and media player integration.",
  "main": "dist-electron/main/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-electron.mjs && concurrently -k \"node scripts/build-electron.mjs --watch\" \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build:main": "node scripts/build-electron.mjs",
    "build": "node scripts/build-electron.mjs && vite build",
    "start": "electron .",
    "setup:bin": "node scripts/setup-aria2.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "type-check": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.7",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.shuunn.desktop",
    "productName": "shuunn",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "brand/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/aria2c.exe",
        "to": "bin/aria2c.exe"
      },
      {
        "from": "brand",
        "to": "brand"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "brand/taskbar/taskbar-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "shuunn"
    }
  }
}
